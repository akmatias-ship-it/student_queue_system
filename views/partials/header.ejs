
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= typeof title !== 'undefined' ? title : 'Campus Queue' %> | Campus Queue</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <a class="brand" href="/">Campus Queue</a>
      <nav>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a href="/dashboard">Dashboard</a>
          <% if (currentUser.role === 'student') { %>
            <a href="/queue/mine">My Tickets</a>
          <% } %>
          <% if (['admin', 'staff'].includes(currentUser.role)) { %>
            <a href="/queue/staff">Queue Desk</a>
          <% } %>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin/services">Services</a>
          <% } %>
          <form class="inline" method="post" action="/logout">
            <button class="link" type="submit">Log out</button>
          </form>
        <% } else { %>
          <a href="/login">Log in</a>
        <% } %>
      </nav>
    </header>
    <main class="container">
      <% (typeof successMessages !== 'undefined' ? successMessages : []).forEach(m => { %>
        <div class="alert success"><%= m %></div>
      <% }) %>
      <% (typeof errorMessages !== 'undefined' ? errorMessages : []).forEach(m => { %>
        <div class="alert error"><%= m %></div>
      <% }) %>
    </main>
  </body>
</html>
